# Example tfvars — copy to terraform.tfvars (gitignored) and fill in, or pass
# each as -var / TF_VAR_* at apply. NO real secrets committed here.

# Connection (bootstrap.sh port-forwards Keycloak and supplies the admin creds).
keycloak_url            = "http://localhost:8080"
keycloak_admin_username = "admin"
keycloak_admin_password = ""

# Human login.
dashboard_origin        = "http://localhost:8090"
dashboard_client_secret = ""

# Control-plane clients.
orchestrator_client_secret = ""
idp_consent_client_secret  = ""
org_admin_client_secret    = "" # registry org directory (multi-tenancy)

# Machine clients (Phase 0 placeholder secret; attestation arrives in Phase 1).
machine_client_secret = ""

# Users — leave a password empty to NOT create that user (fail-closed).
alice_password  = ""
viewer_password = ""
bob_password    = "" # org admin of the demo `globex` org (SpiceDB tuple, not a realm role)
