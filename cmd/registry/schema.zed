// Default SpiceDB schema for the Spawnly platform.
//
// This file is the SINGLE SOURCE OF TRUTH for the schema: it is embedded into
// the registry binary (see //go:embed in cmd/registry/main.go) and written to
// SpiceDB by the registry on boot. A consumer can override it at runtime via
// the SPICEDB_SCHEMA_PATH env var without rebuilding.
//
// deploy/spicedb/schema.zed is a reference copy of this file.
//
// EXTENSION CONTRACT (Phase 5a): every revocable permission must intersect with
// the agent's own `enabled` flag (`& agent->enabled`). Revoke/resume toggle the
// single `agent:<id>#enabled@agent:<id>` tuple; a permission that omits the
// intersection will NOT be revocable. A consumer overriding this schema must
// preserve that convention for their permissions to honour revoke.
// A human principal. Its object id is the userId (token sub). Empty so far —
// it is only ever referenced as the subject of agent#owner / organization
// member/admin relations.
definition user {}

// An organization is the SaaS account authorization boundary (the NEW
// multi-tenancy primitive, distinct from `tenant` below). Membership is
// mirrored here from Keycloak: `member` for ordinary members, `admin` for org
// admins. admin_agents is the org-wide capability the agent view/manage
// permissions below fan into (an org admin sees/manages every agent in the
// org). view_agents backs org-MEMBERSHIP checks (orgMemberCheck, /v1/my/orgs,
// requireOrgMember) — NOT per-agent visibility: a plain member sees ONLY the
// agents they own.
definition organization {
    relation member: user
    relation admin: user
    // view_agents = "is a member of this org?" (admin ⊇ member); it gates
    // membership queries, not per-agent view (which is org-admin-only).
    permission view_agents = member + admin
    permission admin_agents = admin
}

definition agent {
    // Exactly one tuple per agent: agent:<id>#enabled@agent:<id>.
    // Present while the agent is active; absent while revoked.
    relation enabled: agent

    // Human lifecycle authority over the agent. owner is the spawning user;
    // org (present only for org-scoped agents) fans into the owning org's
    // ADMINS. view = read (list/events/logs/chain); manage = mutate
    // (spawn/message/revoke/resume/dismiss/kill). Both are now owner + org
    // admin: a plain member sees ONLY agents they own; an org admin sees and
    // manages every agent in the org.
    relation owner: user
    relation org: organization

    // view/manage are HUMAN lifecycle authority and DELIBERATELY do NOT
    // intersect `& agent->enabled`: resume must be checkable on a revoked agent
    // (whose enabled tuple is absent), so gating manage on enabled would make a
    // revoked agent un-resumable. The enabled-intersection EXTENSION CONTRACT
    // above governs agent-RUNTIME permissions (e.g. tenant.work_on), not these
    // control-plane lifecycle checks.
    permission view = owner + org->admin_agents
    permission manage = owner + org->admin_agents
}

definition tenant {
    relation agent: agent
    permission work_on = agent & agent->enabled
}
