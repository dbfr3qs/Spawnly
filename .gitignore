# Go binaries (root-level and bin/)
/agent
/agent-sidecar
/operator
/orchestrator
/registry
/sample-api
/dashboard
/bin/
*.test
vendor/

# Node
agents/*/node_modules/
agents/*/dist/
sdks/*/node_modules/
sdks/*/dist/

# E2E (Playwright) — match run artifacts wherever Playwright is invoked from
# (repo root or e2e/), not just under e2e/.
e2e/node_modules/
test-results/
playwright-report/
e2e/playwright/.auth/

# Dev scripts for dashboard iteration (not part of the build)
analyze-dashboard.mjs
e2e/analyze-ui.mjs
e2e/test-theme-*.mjs

# Keycloak SPI provider build output (Maven)
keycloak/providers/target/

# Stray local tooling caches
dotnet/

# IDE
.idea/
*.suo
*.user

# devcontainer generated
.devcontainer/devcontainer-lock.json

# Claude Code worktrees
.claude/worktrees/
.claude/

# Kubernetes / local dev
kubeconfig
*.kubeconfig

# org-subdomains local TLS mimic (Phase 3) — Caddy internal-CA state, certs, and
# the runtime port-forward pid. Never commit CA/cert material.
deploy/local-tls/data/
deploy/local-tls/config/
deploy/local-tls/certs/
deploy/local-tls/.port-forward.pid

# remote-substrate: throwaway x509pop dev CA / leaf material. The scripts write
# these only into mktemp dirs + cluster Secrets, never the repo — this is a
# defensive belt so no CA/key/cert PEM can ever be committed if an output path is
# pointed at the tree.
deploy/substrate/.ca/
deploy/substrate/**/*.pem
deploy/substrate/**/*.key
deploy/substrate/**/*.crt
substrate-*.pem
substrate-*.key
substrate-*.crt

# Local secrets / env (keep .env.example tracked)
.env
.env.local
!.env.example

plans/
.piignore
